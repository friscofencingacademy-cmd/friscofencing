# Live-registration audit config (docs/plans/audit-system-plan.md). Copy to
# .env (gitignored) and fill in real staging values before running.

# Frontend staging URL the browser navigates to — hard-checked to contain
# "friscofencing" but not be the bare production host. No separate backend
# URL: every request (including the final report) goes through the
# frontend's own /api/v1/* proxy, the same path a real browser uses, so the
# httpOnly login cookie (scoped to this origin) is actually sent. A raw
# backend-origin URL would be a different domain and wouldn't carry it.
AUDIT_STAGING_URL=https://friscofencing-git-develop-frisco-fencing.vercel.app

# Shared password for every seeded audit-*@example.com account (set via
# backend/scripts/audit-seed.js, same value as backend/.env's
# AUDIT_TEST_PASSWORD).
AUDIT_TEST_PASSWORD=

# Existing staging superadmin login — used ONLY for the final reporting step
# (POST /audit-runs is superadmin-gated). Not a new account; reuse the one
# already seeded per docs/plans/deployment-launch-plan.md.
AUDIT_SUPERADMIN_EMAIL=
AUDIT_SUPERADMIN_PASSWORD=

# Run in a visible browser window instead of headless — useful for the first
# run of a new/changed scenario. Any value other than "true" runs headless.
AUDIT_HEADED=false
