MONGO_URI=mongodb://localhost:27017/frisco-fencing-dev
PORT=4000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
STRIPE_SECRET_KEY=
# Obtained locally by running `stripe listen --forward-to localhost:<PORT>/api/v1/webhooks/stripe`
# (Stripe CLI), which prints a signing secret for that session.
STRIPE_WEBHOOK_SECRET=
# Email (Phase 10). All optional — leave every SMTP_* value blank for the
# supported, zero-setup local dev path: mail.service.js will automatically
# mint a free Ethereal (https://ethereal.email) test account on first send
# and log its credentials so you can view "sent" emails in a browser, no
# real email-provider signup required. Set SMTP_HOST (and friends) to route
# through a real SMTP provider instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@friscofencing.local
