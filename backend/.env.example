MONGO_URI=mongodb://localhost:27017/frisco-fencing-dev
PORT=4000
NODE_ENV=development
# Staging email gate (ckq-parity plan, Phase 1) -- fail-closed. Real SMTP
# sends only go out when APP_ENV=production. Any other value (or unset)
# blocks the transport send while still rendering the full email (so staging
# QA loops via scripts/preview-emails.js still work). Ethereal (no SMTP_HOST)
# is exempt -- local dev is never blocked. Set this to `production` in the
# Production-scope Vercel env only; leave unset (or `staging`) in Preview.
APP_ENV=
# CC target for internal/admin-facing email copies (registration, private
# class, cancellation, etc.) -- see docs/modules/email.md.
ADMIN_EMAIL=friscofencingacademy@gmail.com
# Absolute, publicly-reachable logo image URL for the email header. Optional
# -- when unset, emails render a styled text wordmark instead of an <img>.
LOGO_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
# Stopgap seed script (scripts/seed-coach.js) until there's a real
# admin-facing path to create staff accounts -- see CLAUDE_HISTORY.md.
COACH_EMAIL=
COACH_PASSWORD=
COACH_FIRST_NAME=
COACH_LAST_NAME=
STRIPE_SECRET_KEY=
# Obtained locally by running `stripe listen --forward-to localhost:<PORT>/api/v1/webhooks/stripe`
# (Stripe CLI), which prints a signing secret for that session.
STRIPE_WEBHOOK_SECRET=
# Email (Phase 10). All optional — leave every SMTP_* value blank for the
# supported, zero-setup local dev path: mail.service.js will automatically
# mint a free Ethereal (https://ethereal.email) test account on first send
# and log its credentials so you can view "sent" emails in a browser, no
# real email-provider signup required. Set SMTP_HOST (and friends) to route
# through a real SMTP provider instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@friscofencing.local
# Vercel Blob (public-site plan) — image uploads for the admin Spotlights
# page. Auto-provisioned when a Blob store is created/connected via
# `vercel blob create-store`; not required for tests (the SDK is mocked
# at the module boundary, see docs/TESTING_STRATEGY.md).
BLOB_READ_WRITE_TOKEN=
# Live-registration audit (docs/plans/audit-system-plan.md) — scripts/audit-
# seed.js and scripts/audit-reset.js. AUDIT_MONGO_URI must point at the
# STAGING cluster (both scripts hard-fail otherwise) — never set this to a
# production URI. Leave both blank for normal local dev; only needed when
# running `npm run audit:seed` / `npm run audit:reset` against staging.
AUDIT_MONGO_URI=
AUDIT_TEST_PASSWORD=
